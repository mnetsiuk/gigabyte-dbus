# Contributor: Albert Tang <tangalbert919@yahoo.com>

pkgbase=gigabyte-dbus
pkgname=gigabyte-dbus
pkgver=1.1.0
pkgrel=1
pkgdesc="A control daemon for interacting with Gigabyte laptops"
arch=('x86_64')
url="https://github.com/mnetsiuk/gigabyte-dbus"
license=('MPL-2.0')
makedepends=(
  git
  "rust>=1.87"
  systemd
)
install=gigabyte-dbus.install
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgbase}"
  cargo build --release --locked
  strip -s ./target/release/gigabyted
}

package() {
  cd "${srcdir}/${pkgbase}"
  make DESTDIR="${pkgdir}" UDEVRULESDIR=/usr/lib/udev/rules.d install
}
