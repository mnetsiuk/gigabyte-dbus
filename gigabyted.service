[Unit]
Description=Gigabyte Laptop Control
StartLimitInterval=200
StartLimitBurst=2
After=systemd-udevd.service
# Started by the udev rule when the aorus_laptop driver binds, stopped when it goes away.
BindsTo=sys-devices-platform-aorus_laptop.device
After=sys-devices-platform-aorus_laptop.device

[Service]
Environment=IS_SERVICE=1
Environment=RUST_LOG="info"
ExecStart=/usr/bin/gigabyted
StateDirectory=gigabyted
# If the daemon was driving the fans itself (fast curve), give them back to the EC's curve.
ExecStopPost=/usr/bin/gigabyted --hand-back
Restart=on-failure
RestartSec=1
Type=dbus
BusName=com.gigabyte.daemon
# The daemon writes only the driver's and RAPL's sysfs files, its state directory and the keyboard's
# hidraw node, all root's own, and talks to D-Bus and systemd over Unix sockets: no capabilities.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-hidraw rw
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
SELinuxContext=system_u:system_r:unconfined_t:s0
#SELinuxContext=system_u:object_r:modules_object_t:s0
