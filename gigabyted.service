[Unit]
Description=Gigabyte Laptop Control
StartLimitInterval=200
StartLimitBurst=2
After=systemd-udevd.service
# Started by the udev rule when the aorus_laptop driver binds, stopped when it goes away.
BindsTo=sys-devices-platform-aorus_laptop.device
After=sys-devices-platform-aorus_laptop.device

[Service]
Environment=IS_SERVICE=1
Environment=RUST_LOG="info"
ExecStart=/usr/bin/gigabyted
StateDirectory=gigabyted
# If the daemon was driving the fans itself (fast curve), give them back to the EC's curve.
ExecStopPost=/usr/bin/gigabyted --hand-back
Restart=on-failure
RestartSec=1
Type=dbus
BusName=com.gigabyte.daemon
SELinuxContext=system_u:system_r:unconfined_t:s0
#SELinuxContext=system_u:object_r:modules_object_t:s0
